{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theprooffoundry.com/schemas/product-release-submission-v1.schema.json",
  "title": "Proof Foundry Product Release Submission V1",
  "description": "Submitted artifact and evidence references for a Product Publishing Capsule. It is not site-manifest.json and has no verification authority.",
  "type": "object",
  "required": ["schemaVersion", "productId", "version", "platforms", "artifacts", "evidence", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .()+/_-]{0,63}$" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
  },
  "additionalProperties": false,
  "$defs": {
    "artifactPath": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)release/artifacts/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "evidencePath": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)release/evidence/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "artifact": {
      "type": "object", "required": ["path", "platform", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/artifactPath" },
        "platform": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .()+/_-]{0,63}$" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object", "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "kind": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
        "path": { "$ref": "#/$defs/evidencePath" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object", "required": ["id", "summary", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" } }
      },
      "additionalProperties": false
    }
  }
}
