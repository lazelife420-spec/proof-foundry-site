{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theprooffoundry.com/schemas/product-owner-approval-v1.schema.json",
  "title": "Proof Foundry Product Owner Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalVersion", "decision", "approvalId", "approvalPackageDigest", "candidateId", "candidateDigest",
    "capsuleSha256", "publisherCommit", "publisherTree", "baseSiteCommit", "baseSiteTree", "productId",
    "submissionType", "artifactSha256", "approvedActions", "approvedAt", "signatureAlgorithm", "signerKeyId", "signature"
  ],
  "properties": {
    "approvalVersion": { "const": 1 },
    "decision": { "const": "OWNER_APPROVED" },
    "approvalId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvalPackageDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capsuleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publisherCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publisherTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseSiteCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseSiteTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "productId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "submissionType": { "enum": ["NEW_PRODUCT", "NEW_VERSION", "PRESENTATION_UPDATE"] },
    "artifactSha256": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "approvedActions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["PUBLISH_ARTIFACTS", "PROMOTE_CANONICAL_STATE", "DEPLOY_SITE", "VERIFY_LIVE"] }
    },
    "approvedAt": { "type": "string", "format": "date-time" },
    "signatureAlgorithm": { "const": "Ed25519" },
    "signerKeyId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
